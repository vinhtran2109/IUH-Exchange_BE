# ============================================================
# IUH Campus Exchange Platform - Environment Variables
# ⚠️  KHÔNG COMMIT file này lên Git! Thêm vào .gitignore
# ============================================================

# ── MongoDB ──
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=iuh_exchange_root
MONGO_DATABASE=iuh_exchange

# ── Redis ──
REDIS_PASSWORD=iuh_exchange_redis

# ── JWT ──
JWT_SECRET=iuh-exchange-super-secret-key-change-in-production-2024
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── Config Server ──
CONFIG_SERVER_USER=config-admin
CONFIG_SERVER_PASSWORD=config-admin-password

# ── Eureka ──
EUREKA_USER=eureka-admin
EUREKA_PASSWORD=eureka-admin-password

# ── AWS S3 (điền thông tin thực ở Phase 3) ──
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=iuh-exchange-products
AWS_REGION=ap-southeast-1

# ── Email (SMTP/SendGrid - Phase 2) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
