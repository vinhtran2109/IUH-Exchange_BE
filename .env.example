# ============================================
# IUH Exchange - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ── Required ──
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── MongoDB Root Credentials (used by docker-compose) ──
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=iuh_exchange_root

# ── MongoDB ──
USER_SERVICE_MONGO_URI=mongodb://root:iuh_exchange_root@localhost:27018/iuh_users?authSource=admin
PRODUCT_SERVICE_MONGO_URI=mongodb://root:iuh_exchange_root@localhost:27018/iuh_products?authSource=admin
ORDER_SERVICE_MONGO_URI=mongodb://root:iuh_exchange_root@localhost:27018/iuh_orders?authSource=admin
NOTIFICATION_SERVICE_MONGO_URI=mongodb://root:iuh_exchange_root@localhost:27018/iuh_notifications?authSource=admin
CHAT_SERVICE_MONGO_URI=mongodb://root:iuh_exchange_root@localhost:27018/iuh_chat?authSource=admin
LOSTFOUND_SERVICE_MONGO_URI=mongodb://root:iuh_exchange_root@localhost:27018/iuh_lostfound?authSource=admin

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=iuh_exchange_redis

# ── Kafka ──
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=iuh-exchange

# ── ElasticSearch ──
ELASTICSEARCH_NODE=http://localhost:9200

# ── AWS S3 (for image uploads) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=iuh-exchange-products

# ── SMTP (for OTP emails) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_NAME=IUH Exchange

# ── Gateway ──
GATEWAY_PORT=8080
CORS_ORIGIN=http://localhost:5173
GATEWAY_SECRET=

# ── JWT Expiration ──
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Logging ──
LOG_LEVEL=info
NODE_ENV=development
