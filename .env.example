# ============================================================
# IUH Campus Exchange Platform - Environment Variables (Node.js)
# ============================================================

# ── MongoDB ──
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=iuh_exchange_root

# ── Per-service MongoDB URIs ──
USER_SERVICE_MONGO_URI=mongodb://user_svc:user_svc_pass@mongodb:27017/iuh_users?authSource=iuh_users
PRODUCT_SERVICE_MONGO_URI=mongodb://product_svc:product_svc_pass@mongodb:27017/iuh_products?authSource=iuh_products
ORDER_SERVICE_MONGO_URI=mongodb://order_svc:order_svc_pass@mongodb:27017/iuh_orders?authSource=iuh_orders
NOTIFICATION_SERVICE_MONGO_URI=mongodb://notification_svc:notification_svc_pass@mongodb:27017/iuh_notifications?authSource=iuh_notifications
CHAT_SERVICE_MONGO_URI=mongodb://chat_svc:chat_svc_pass@mongodb:27017/iuh_chat?authSource=iuh_chat
LOSTFOUND_SERVICE_MONGO_URI=mongodb://lostfound_svc:lostfound_svc_pass@mongodb:27017/iuh_lostfound?authSource=iuh_lostfound

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=iuh_exchange_redis

# ── Kafka ──
KAFKA_BROKERS=kafka:29092

# ── JWT ──
JWT_SECRET=iuh-exchange-super-secret-key-change-in-production-2024
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── AWS S3 ──
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=iuh-exchange-products

# ── ElasticSearch ──
ELASTICSEARCH_NODE=http://elasticsearch:9200

# ── CORS ──
CORS_ORIGIN=*
