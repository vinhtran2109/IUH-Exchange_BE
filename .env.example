# ============================================================
# IUH Exchange - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ============================================================

# ─────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=

# MongoDB Atlas connection strings.
# Fill each MongoDB URI from your Atlas dashboard. Do not commit real credentials.
# URL-encode the password if it contains special characters.
MONGODB_URI=
USER_SERVICE_MONGO_URI=
PRODUCT_SERVICE_MONGO_URI=
ORDER_SERVICE_MONGO_URI=
NOTIFICATION_SERVICE_MONGO_URI=
CHAT_SERVICE_MONGO_URI=
LOSTFOUND_SERVICE_MONGO_URI=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ─────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092
# KAFKA_CLIENT_ID=iuh-exchange

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─────────────────────────────────────────────
# AWS S3 (image upload)
# ─────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=your_s3_bucket_name

# ─────────────────────────────────────────────
# ElasticSearch
# ─────────────────────────────────────────────
ELASTICSEARCH_NODE=http://elasticsearch:9200

# ─────────────────────────────────────────────
# SMTP / Email (notification-service)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com  # Optional: defaults to SMTP_USER

# ─────────────────────────────────────────────
# Firebase Cloud Messaging (notification-service)
# ─────────────────────────────────────────────
# Option 1: Use service account JSON file (mounted via docker-compose)
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
# Option 2: Use env vars directly
# FIREBASE_PROJECT_ID=iuhexchange
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@iuhexchange.iam.gserviceaccount.com

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# API Gateway
# ─────────────────────────────────────────────
# GATEWAY_SECRET=your_gateway_secret

# ─────────────────────────────────────────────
# Logging (optional - defaults are fine for dev)
# ─────────────────────────────────────────────
# LOG_LEVEL=info
# LOG_DIR=logs
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=14d
# LOGSTASH_URL=http://logstash:9600

# ─────────────────────────────────────────────
# App Info
# ─────────────────────────────────────────────
APP_NAME=IUH Exchange
