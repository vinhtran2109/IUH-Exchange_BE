# Git ignore rules for IUH Campus Exchange Platform

# ── Environment files ──
.env
*.env.local
*.env.production

# ── Maven ──
target/
*.class
*.jar
*.war

# ── IDE ──
.idea/
*.iml
.vscode/
.eclipse/

# ── OS ──
.DS_Store
Thumbs.db

# ── Logs ──
*.log
logs/

# ── Docker volumes (nếu mount local) ──
data/
